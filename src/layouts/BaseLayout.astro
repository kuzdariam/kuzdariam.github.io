---
import '../styles/global.css';
import { site } from '../content/site.ts';
import Sparkle from '../components/icons/Sparkle.astro';
import Leaf from '../components/icons/Leaf.astro';
import Dots from '../components/icons/Dots.astro';
import Moon from '../components/icons/Moon.astro';

interface Props {
  title: string;
  description: string;
  lang?: string;
}

const { title, description, lang = 'ru' } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const siteOrigin = new URL('/', Astro.site).toString();
const siteName = 'Дарья Кузнецова — психолог';
const ogLocale = lang === 'ru' ? 'ru_RU' : lang;

const emailLink = site.contacts.links.find((l) => l.href.startsWith('mailto:'));
const sameAs = site.contacts.links
  .filter((l) => /^https?:\/\//.test(l.href))
  .map((l) => l.href);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteOrigin}#person`,
      name: 'Дарья Кузнецова',
      alternateName: 'Daria Kuznetsova',
      jobTitle: 'Клинический психолог',
      url: siteOrigin,
      knowsLanguage: ['ru'],
      ...(emailLink && { email: emailLink.href.replace('mailto:', '') }),
      ...(sameAs.length > 0 && { sameAs }),
      worksFor: { '@id': `${siteOrigin}#business` },
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${siteOrigin}#business`,
      name: siteName,
      url: siteOrigin,
      description,
      address: {
        '@type': 'PostalAddress',
        streetAddress: site.address.streetAddress,
        postalCode: site.address.postalCode,
        addressLocality: site.address.addressLocality,
        addressCountry: site.address.addressCountry,
      },
      areaServed: [
        { '@type': 'City', name: 'Amsterdam' },
        { '@type': 'Country', name: 'Netherlands' },
      ],
      availableLanguage: ['ru'],
      priceRange: '90€–100€',
      provider: { '@id': `${siteOrigin}#person` },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteOrigin}#website`,
      url: siteOrigin,
      name: siteName,
      inLanguage: 'ru-RU',
      publisher: { '@id': `${siteOrigin}#person` },
    },
  ],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#B9AED4" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={ogLocale} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body class="bg-beige text-graphite">
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 z-0">
      <Sparkle class="absolute top-20 right-[8%] h-10 w-10 text-coral/50 md:h-14 md:w-14" />
      <Sparkle class="absolute top-32 right-[22%] hidden h-5 w-5 text-lavender md:block" />
      <Sparkle class="absolute bottom-24 left-[6%] h-8 w-8 text-lavender md:h-10 md:w-10" />
      <Sparkle class="absolute bottom-40 right-[4%] hidden h-6 w-6 text-coral/40 md:block" />
      <Dots class="absolute top-1/2 left-[3%] hidden w-24 -translate-y-1/2 text-olive-soft md:block" />
      <Dots class="absolute right-[10%] bottom-12 w-20 text-lavender md:w-28" />
      <Leaf class="absolute -bottom-2 left-[28%] hidden h-16 w-16 rotate-12 text-olive md:block" />
      <Moon class="absolute top-20 left-[10%] hidden h-9 w-9 text-coral/40 md:block" />
    </div>
    <div class="relative z-10">
      <slot />
    </div>
  </body>
</html>
