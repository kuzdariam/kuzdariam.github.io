---
interface Props {
  href: string;
  label: string;
  class?: string;
}
const { href, label, class: cls = '' } = Astro.props;
---
<a
  href={href}
  class={`inline-flex items-center gap-2 font-sans text-sm font-semibold uppercase tracking-wide text-coral transition-colors hover:text-terracotta ${cls}`}
>
  {label}
  <span aria-hidden="true">→</span>
</a>
