---
interface Props {
  href: string;
  label: string;
  class?: string;
}
const { href, label, class: cls = '' } = Astro.props;
---
<a
  href={href}
  class={`inline-flex items-center justify-center rounded-md bg-terracotta px-8 py-4 font-sans text-base font-semibold uppercase tracking-wide text-milk transition-colors hover:bg-terracotta/90 ${cls}`}
>
  {label}
</a>
