---
import ArrowLeft from '../icons/ArrowLeft.astro';
import ArrowRight from '../icons/ArrowRight.astro';
import Close from '../icons/Close.astro';

interface Props {
  images: { src: string; alt: string }[];
}
const { images } = Astro.props;
const hasMultiple = images.length > 1;
---
<dialog
  data-lightbox
  data-images={JSON.stringify(images)}
  aria-label="Просмотр сертификата"
  class="m-0 h-screen max-h-screen w-screen max-w-none border-0 bg-graphite/90 p-0 text-milk backdrop:bg-graphite/90"
>
  <div class="flex h-full w-full flex-col">
    <div class="flex justify-end p-4">
      <button
        type="button"
        data-lightbox-close
        aria-label="Закрыть"
        class="p-2 text-milk"
      >
        <Close class="text-milk" />
      </button>
    </div>

    <div data-lightbox-stage class="relative flex flex-1 items-center justify-center overflow-hidden px-4">
      <img data-lightbox-img alt="" class="max-h-full max-w-full touch-none select-none object-contain" />
    </div>

    {hasMultiple && (
      <div class="flex items-center justify-center gap-6 p-6">
        <button
          type="button"
          data-lightbox-prev
          aria-label="Предыдущий"
          class="rounded-full bg-graphite/40 p-3 hover:bg-graphite/60"
        >
          <ArrowLeft class="text-milk" />
        </button>
        <span data-lightbox-counter class="min-w-[3rem] text-center font-sans text-sm text-milk/80"></span>
        <button
          type="button"
          data-lightbox-next
          aria-label="Следующий"
          class="rounded-full bg-graphite/40 p-3 hover:bg-graphite/60"
        >
          <ArrowRight class="text-milk" />
        </button>
      </div>
    )}
  </div>
</dialog>

<script>
  import Panzoom from '@panzoom/panzoom';

  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  if (dialog) {
    const images = JSON.parse(dialog.dataset.images ?? '[]') as { src: string; alt: string }[];
    const stage = document.querySelector<HTMLElement>('[data-lightbox-stage]');
    const img = document.querySelector<HTMLImageElement>('[data-lightbox-img]');
    const closeBtn = document.querySelector<HTMLButtonElement>('[data-lightbox-close]');
    const prevBtn = document.querySelector<HTMLButtonElement>('[data-lightbox-prev]');
    const nextBtn = document.querySelector<HTMLButtonElement>('[data-lightbox-next]');
    const counter = document.querySelector<HTMLElement>('[data-lightbox-counter]');

    let currentIndex = 0;
    let preloaded = false;

    const panzoom = img ? Panzoom(img, {
      maxScale: 5,
      minScale: 1,
      animate: false,
      step: 0.15,
      panOnlyWhenZoomed: true,
    }) : null;

    stage?.addEventListener('wheel', (e) => {
      if (!panzoom) return;
      if (!e.ctrlKey) return;
      e.preventDefault();
      panzoom.zoomWithWheel(e);
    }, { passive: false });

    img?.addEventListener('load', () => {
      panzoom?.reset({ animate: false });
    });

    // Re-center the image when zoomed back out to 1x: Panzoom's panOnlyWhenZoomed
    // freezes pan at scale ≤ 1 but doesn't reset accumulated offset, so the image
    // can stay shifted off-center after zoom-out.
    img?.addEventListener('panzoomchange', (e: Event) => {
      const { scale } = (e as CustomEvent<{ scale: number }>).detail;
      if (scale <= 1.001) panzoom?.pan(0, 0, { animate: false, force: true });
    });

    function render(i: number) {
      currentIndex = (i + images.length) % images.length;
      panzoom?.reset({ animate: false });
      if (img) {
        img.src = images[currentIndex].src;
        img.alt = images[currentIndex].alt;
      }
      if (counter) counter.textContent = `${currentIndex + 1} / ${images.length}`;
    }

    function preloadAll() {
      if (preloaded) return;
      preloaded = true;
      images.forEach(({ src }) => {
        const i = new Image();
        i.src = src;
      });
    }

    function open(i: number) {
      render(i);
      dialog!.showModal();
      preloadAll();
    }
    function close() {
      dialog!.close();
    }

    document.querySelectorAll('[data-lightbox-open]').forEach((el) => {
      el.addEventListener('click', () => {
        open(Number(el.getAttribute('data-lightbox-open')));
      });
    });

    closeBtn?.addEventListener('click', close);
    prevBtn?.addEventListener('click', () => render(currentIndex - 1));
    nextBtn?.addEventListener('click', () => render(currentIndex + 1));

    stage?.addEventListener('click', (e) => {
      if (e.target === stage) close();
    });

    document.addEventListener('keydown', (e) => {
      if (!dialog!.open) return;
      if (e.key === 'ArrowLeft') render(currentIndex - 1);
      if (e.key === 'ArrowRight') render(currentIndex + 1);
    });

    img?.addEventListener('dblclick', () => {
      if (!panzoom) return;
      if (panzoom.getScale() > 1) panzoom.reset();
      else panzoom.zoom(2);
    });

    dialog.addEventListener('close', () => {
      panzoom?.reset({ animate: false });
    });
  }
</script>
