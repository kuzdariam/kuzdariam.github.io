---
import { site } from '../../content/site.ts';
import { splitOnHighlight } from '../../content/utils.ts';
import WavyUnderline from '../ui/WavyUnderline.astro';
import Heart from '../icons/Heart.astro';
import Moon from '../icons/Moon.astro';
import Sparkle from '../icons/Sparkle.astro';
import Leaf from '../icons/Leaf.astro';
import Flower from '../icons/Flower.astro';
import Waves from '../icons/Waves.astro';

const t = site.topics;

const icons = [Heart, Waves, Sparkle, Leaf, Moon, Flower];

const { before: calloutBefore, word, after: calloutAfter } = splitOnHighlight(t.callout.title, t.callout.highlightedWord);
---
<section id="topics" class="py-20 md:py-28">
  <div class="mx-auto max-w-container px-6 md:px-10">
    <h2 class="text-center font-display text-3xl font-bold uppercase text-graphite md:text-4xl lg:text-5xl">
      {t.headline}
    </h2>

    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {t.items.map((item, i) => {
        const Icon = icons[i % icons.length];
        return (
          <article
            class={`rounded-2xl p-8 ${i % 2 === 0 ? 'bg-olive-soft' : 'bg-lavender'}`}
          >
            <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-full bg-milk">
              <Icon class="h-7 w-7 text-terracotta" />
            </div>
            <p class="font-sans text-base leading-relaxed text-graphite md:text-lg">{item}</p>
          </article>
        );
      })}
    </div>

    <div class="mt-12 rounded-3xl bg-sand p-8 md:p-12">
      <h3 class="font-display text-2xl font-semibold text-graphite md:text-3xl">
        {calloutBefore}<WavyUnderline word={word} />{calloutAfter}
      </h3>
      <p class="mt-4 font-sans text-base leading-relaxed text-graphite md:text-lg">
        {t.callout.body}
      </p>
    </div>
  </div>
</section>
