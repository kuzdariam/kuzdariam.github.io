---
import { site } from '../../content/site.ts';
import { splitOnHighlight, splitOnBold } from '../../content/utils.ts';
import WavyUnderline from '../ui/WavyUnderline.astro';

const p = site.pricing;

const intro = splitOnHighlight(p.introTemplate, p.introHighlightedWord);

const [card1, card2] = p.cards;

const card1Body = splitOnBold(card1.bodyTemplate, card1.bodyBoldWord!);
const card1Price = splitOnBold(card1.priceTemplate, card1.priceBoldWord);

const card2BodyIntro = splitOnHighlight(card2.bodyTemplate, card2.bodyHighlightedWord!);
const card2Price = splitOnBold(card2.priceTemplate, card2.priceBoldWord);
---
<section id="pricing" class="py-20 md:py-28">
  <div class="mx-auto max-w-container px-6 md:px-10">
    <h2 class="text-center font-display text-3xl font-bold uppercase text-graphite md:text-4xl lg:text-5xl">
      {p.headline}
    </h2>

    <p class="mx-auto mt-6 max-w-2xl text-center font-sans text-base text-graphite md:text-lg">
      {intro.before}<WavyUnderline word={intro.word} />{intro.after}
    </p>
    <p class="mx-auto mt-3 max-w-2xl text-center font-sans text-base text-graphite md:text-lg">
      {p.introBody}
    </p>

    <div class="mx-auto mt-12 grid max-w-4xl grid-cols-1 gap-6 md:grid-cols-2">
      <article class="rounded-2xl bg-sand p-8 md:p-10">
        <h3 class="font-display text-2xl font-semibold text-graphite md:text-3xl">{card1.title}</h3>
        <p class="mt-4 font-sans text-base leading-relaxed text-graphite">
          {card1Body.before}<strong class="font-semibold">{card1Body.word}</strong>{card1Body.after}
        </p>
        <p class="mt-6 font-sans text-base leading-relaxed text-graphite">
          {card1Price.before}<strong class="font-semibold">{card1Price.word}</strong>{card1Price.after}
        </p>
        <p class="mt-1 font-sans text-base text-graphite">{card1.duration}</p>
      </article>

      <article class="rounded-2xl bg-sand p-8 md:p-10">
        <h3 class="font-display text-2xl font-semibold text-graphite md:text-3xl">{card2.title}</h3>
        <p class="mt-4 font-sans text-base leading-relaxed text-graphite">
          {card2BodyIntro.before}<WavyUnderline word={card2BodyIntro.word} />{card2BodyIntro.after}
        </p>
        <p class="mt-3 font-sans text-base leading-relaxed text-graphite">{card2.bodyRest}</p>
        <p class="mt-6 font-sans text-base leading-relaxed text-graphite">
          {card2Price.before}<strong class="font-semibold">{card2Price.word}</strong>{card2Price.after}
        </p>
        <p class="mt-1 font-sans text-base text-graphite">{card2.duration}</p>
      </article>
    </div>
  </div>
</section>
