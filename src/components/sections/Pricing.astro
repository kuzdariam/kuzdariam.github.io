---
import { site } from '../../content/site.ts';

const p = site.pricing;
---
<section id="pricing" class="py-20 md:py-28">
  <div class="mx-auto max-w-container px-6 md:px-10">
    <h2 class="text-center font-display text-3xl font-bold uppercase text-graphite md:text-4xl lg:text-5xl">
      {p.headline}
    </h2>

    <div class="mx-auto mt-12 grid max-w-3xl grid-cols-1 gap-6 md:grid-cols-2">
      {p.cards.map((card) => (
        <article class="rounded-2xl bg-sand p-8 text-center md:p-10">
          <h3 class="font-display text-xl font-semibold text-graphite md:text-2xl">{card.format}</h3>
          <p class="mt-2 font-sans text-base text-graphite/80">{card.duration}</p>
          <p class="mt-6 font-display text-3xl font-bold text-graphite md:text-4xl">{card.price}</p>
        </article>
      ))}
    </div>
  </div>
</section>
