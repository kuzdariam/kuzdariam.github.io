---
import { Image } from 'astro:assets';
import { site } from '../../content/site.ts';
import PillButton from '../ui/PillButton.astro';
import mainPhoto from '../../assets/photos/main_photo.jpg';
import nameImage from '../../assets/photos/my_name.png';

const h = site.hero;
---
<section id="hero" class="relative">
  <div class="mx-auto flex max-w-container flex-col gap-8 px-6 py-16 md:flex-row md:items-stretch md:gap-8 md:py-24 md:px-10 lg:gap-16">
    <div class="order-2 mx-auto w-full max-w-md md:order-none md:mx-0 md:w-1/2 md:max-w-none md:shrink-0 lg:w-[440px]">
      <Image
        src={mainPhoto}
        alt="Дарья Кузнецова"
        widths={[480, 720, 960, 1200]}
        sizes="(min-width: 1024px) 440px, (min-width: 768px) 50vw, 100vw"
        class="h-auto w-full rounded-3xl object-cover shadow-lg md:h-full"
      />
    </div>

    <div class="contents md:flex md:flex-1 md:flex-col md:items-center md:gap-4 md:text-center lg:gap-6">
      <h1 class="order-1 w-full md:order-none">
        <span class="sr-only">Меня зовут Дарья Кузнецова</span>
        <Image
          src={nameImage}
          alt=""
          widths={[480, 720, 960, 1280]}
          sizes="(min-width: 1024px) 60vw, (min-width: 768px) 45vw, 100vw"
          class="mx-auto h-auto w-full md:max-h-[220px] md:w-auto lg:max-h-[380px]"
        />
      </h1>

      <p class="order-3 w-full text-center font-sans text-lg leading-relaxed text-graphite/90 md:order-none md:text-base md:leading-snug lg:text-2xl lg:leading-snug">
        {h.tagline}
      </p>

      <div class="order-4 w-full md:order-none md:mt-auto">
        <PillButton href={h.cta.href} label={h.cta.label} class="w-full" />
      </div>
    </div>
  </div>
</section>
