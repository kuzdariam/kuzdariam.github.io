---
import { site } from '../../content/site.ts';

const a = site.about;
---
<section id="about" class="py-20 md:py-28">
  <div class="mx-auto max-w-container px-6 md:px-10">
    <h2 class="mx-auto max-w-5xl text-center font-display text-3xl font-bold uppercase leading-tight text-graphite md:text-4xl lg:text-5xl">
      {a.headline}
    </h2>

    <p class="mx-auto mt-8 max-w-3xl text-center font-sans text-base leading-relaxed text-graphite md:text-lg">
      {a.intro}
    </p>

    <div class="mt-16 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
      {a.cards.map((card) => (
        <article class="rounded-2xl bg-sand p-6 md:p-8">
          <h3 class="font-display text-xl font-semibold text-graphite md:text-2xl">{card.title}</h3>
          <p class="mt-4 font-sans text-sm leading-relaxed text-graphite">{card.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
