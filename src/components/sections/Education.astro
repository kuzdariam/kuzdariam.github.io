---
import { Image, getImage } from 'astro:assets';
import { site } from '../../content/site.ts';
import { splitOnHighlight } from '../../content/utils.ts';
import Lightbox from '../ui/Lightbox.astro';
import WavyUnderline from '../ui/WavyUnderline.astro';
import diploma from '../../assets/photos/education/diploma.png';
import kpt from '../../assets/photos/education/kpt.png';

const e = site.education;
const { before: sublineBefore, word, after: sublineAfter } = splitOnHighlight(e.subline, e.highlightedWord);

const imageMap: Record<string, ImageMetadata> = { diploma, kpt };
const certs = e.certificates.map((c) => {
  const image = imageMap[c.key];
  if (!image) throw new Error(`Missing image import for certificate key "${c.key}"`);
  return { ...c, image };
});

const lightboxImages = await Promise.all(
  certs.map(async (c) => {
    const optimized = await getImage({
      src: c.image,
      width: 1600,
      format: 'webp',
      quality: 80,
    });
    return { src: optimized.src, alt: c.alt };
  }),
);
---
<section id="education" class="py-20 md:py-28">
  <div class="mx-auto max-w-container px-6 md:px-10">
    <h2 class="text-center font-display text-3xl font-bold uppercase text-graphite md:text-4xl lg:text-5xl">
      {e.headline}
    </h2>
    <p class="mx-auto mt-6 max-w-3xl text-center font-sans text-2xl leading-relaxed text-graphite">
      {sublineBefore}<strong class="font-bold"><WavyUnderline word={word} /></strong>{sublineAfter}
    </p>

    <div class="mx-auto mt-12 grid max-w-5xl grid-cols-1 gap-6 md:grid-cols-2 md:gap-8">
      {certs.map((cert, i) => (
        <button
          type="button"
          data-lightbox-open={i}
          class="group cursor-zoom-in overflow-hidden rounded-2xl shadow-md transition-transform hover:scale-[1.01]"
          aria-label={`Открыть: ${cert.alt}`}
        >
          <Image
            src={cert.image}
            alt={cert.alt}
            widths={[480, 720, 960, 1200]}
            sizes="(min-width: 768px) 50vw, 100vw"
            class="h-auto w-full"
          />
        </button>
      ))}
    </div>
  </div>

  <Lightbox images={lightboxImages as { src: string; alt: string }[]} />
</section>
